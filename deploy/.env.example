# .env — hifi unified deployment

# Cloudflare Tunnel token (for remote access)
TUNNEL_TOKEN=paste-…here

# Navidrome settings
ND_USER=1027:100
ND_MUSIC_PATH=/volume1/Main/Media/music
ND_DATA_PATH=/volume1/docker/navidrome/data
ND_SCAN_SCHEDULE=1h

# ── hifi server ──

# Navidrome credentials for companion library scanning
COMPANION_USER=
COMPANION_PASSWORD=

# Last.fm API key for similar songs/radio (get from https://www.last.fm/api)
LASTFM_API_KEY=

# Minimum star rating for "hot" track flame icon (0-5)
HOT_THRESHOLD=5

# Shared secret for companion + Sonos API endpoints
# Set to a random string to protect APIs from unauthorized access
PROXY_API_KEY=

# LAN URL for Navidrome — used to rewrite stream URLs for Sonos
# Sonos can't reach Cloudflare Tunnel URLs, so set this to your Navidrome LAN address
# Example: http://192.168.68.50:4533
NAVIDROME_LAN_URL=

# Note: For Sonos SSDP discovery to work, run the hifi container with:
#   network_mode: host
# SSDP requires UDP multicast on the local network.
